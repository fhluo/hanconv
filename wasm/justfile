set shell := ["nu", "-c"]
set script-interpreter := ["nu"]
set indentation := "  "
set default-list := true
set fallback

target := "wasm32-unknown-unknown"

setup:
  rustup target add {{target}}
  cargo install wasm-bindgen-cli

build:
  cargo build --release --target {{target}}

[script]
[working-directory('pkg')]
clean:
  let files = [hanconv.d.ts hanconv.js hanconv_bg.wasm hanconv_bg.wasm.d.ts]
  $files | where { |file| $file | path exists } | each { |file| rm $file } | ignore

gen: build clean
  wasm-bindgen --target web --out-dir pkg --out-name hanconv ../target/{{target}}/release/hanconv_wasm.wasm

[working-directory('pkg')]
test: gen
  bun test

[working-directory('pkg')]
pack: gen
  bun pm pack --destination ../dist

[working-directory('pkg')]
pack-test: gen
  bun pm pack --filename ../dist/hanconv.tgz

[working-directory('tests/bun')]
test-bun: pack-test
  bun install
  bun test

[working-directory('tests/node')]
test-node: pack-test
  bun install
  node --test
